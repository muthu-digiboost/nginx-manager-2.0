# =============================================================================
#  Nginx Manager 2.0 - machine-specific settings
#  Copy this file to .env and fill it in. .env is ignored by git.
#  Format: KEY=value, '#' starts a comment, quotes optional, no ${VAR} expansion.
# =============================================================================

# Folder that contains your projects. Site roots are stored relative to it ($projects_dir/...).
# More project folders: add PROJECTS_DIR_<NAME>=<folder>, e.g. PROJECTS_DIR_D=<other folder>,
# which site configs reference as $projects_dir_d/...  (renaming a key means editing those sites)
PROJECTS_DIR=
# Windows only: extra folders prepended to PATH for php-cgi (e.g. Oracle Instant Client). Separate with ';'
PHP_EXTRA_PATH=
# Optional: full path to openssl. Empty = auto-detect (Windows: Git for Windows, then PATH;
# macOS: Homebrew openssl@3, /usr/bin/openssl, then PATH)
OPENSSL_BIN=
# Windows only: PHP build flavour used for downloads: ts or nts
PHP_THREAD_SAFETY=ts
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
MANAGER_HOST=127.0.0.1
MANAGER_PORT=8080
# Time zone for dates in the manager (e.g. Asia/Kolkata). Empty = detected from the system.
APP_TIMEZONE=
# macOS only (both optional): nginx binary and Homebrew folder. Empty = detected
# (/opt/homebrew on Apple silicon, /usr/local on Intel).
NGINX_BIN=
BREW_PREFIX=
