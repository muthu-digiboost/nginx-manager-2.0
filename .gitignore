# =============================================================================
#  Nginx Manager 2.0 - .gitignore
#  The repository holds CODE and TEMPLATES only. Everything that differs per
#  machine (sites, certificates, installed runtimes, state) stays out of git so
#  the same checkout works on any machine: clone, copy .env.example to .env,
#  install nginx.exe + php/, run start-all.ps1.
# =============================================================================

# machine config
.env

# runtime binaries (installed per machine)
/nginx.exe
/php/

# site data - differs per machine
/conf/sites/*
!/conf/sites/_template.conf.example
!/conf/sites/.gitkeep
/ssl/*
!/ssl/configuration.conf
!/ssl/.gitkeep
/data/*
!/data/.gitkeep

# generated / runtime
/conf/generated/
/conf/manager/
/logs/
/temp/
/backups/

# tooling
.idea/
.superpowers/

# Desktop app (Electron): dependencies and build output
/desktop/node_modules/
/desktop/dist/
/desktop/bundle/
/desktop/.cache/
